# Chiavi lette solo da server.mjs: non finiscono mai nella pagina.
# Film, serie TV e anime: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here
# Videogiochi: https://rawg.io/apidocs
RAWG_API_KEY=your_rawg_api_key_here
# Foto generiche (sport, ricorrenze, viaggi…): https://unsplash.com/oauth/applications → "Access Key"
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
# Videogiochi più precisi (IGDB): https://dev.twitch.tv/console/apps → Client ID + Client Secret
TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_CLIENT_SECRET=your_twitch_client_secret_here
# Concerti: https://developer.ticketmaster.com/ → Consumer Key
TICKETMASTER_API_KEY=your_ticketmaster_key_here
# Calcio: https://www.football-data.org/client/register
FOOTBALL_DATA_TOKEN=your_football_data_token_here
# Senza chiavi: Deezer (musica), Nager.Date (festività), TVmaze (serie), Jolpica (F1), Launch Library 2 (spazio).
